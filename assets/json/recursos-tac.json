{% assign sorted_recursos = site.recursos_tac | sort: "order" %}
[
  {% for item in sorted_recursos %}
    {
      "title": {{ item.title | jsonify }},
      "id": {{ item.slug | jsonify }},
      "content": {{ item.content | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]